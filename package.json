{
  "name": "concreta-fem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Motor FEM 3D propio para Concreta (TypeScript + núcleo faer en WASM)",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "nucleo:compilar": "bun scripts/compilar-nucleo.mjs",
    "nucleo:verificar": "bun scripts/compilar-nucleo.mjs --verificar",
    "fem": "bun cli/fem.ts",
    "esquema": "bun scripts/generar-esquema.ts",
    "visor": "bun app/visor.ts",
    "visor:dev": "bun --cwd app run dev"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@kninnug/constrainautor": "4.1.0",
    "@resvg/resvg-wasm": "2.6.2",
    "delaunator": "5.1.0",
    "robust-predicates": "3.0.3"
  }
}
